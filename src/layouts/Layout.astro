---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Compare the true cost of owning cars in India using transparent assumptions you can change.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | CarScore.in</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://www.carscore.in').href} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen bg-[#0b131e] flex flex-col font-sans text-slate-300">
		<header class="bg-[#0b131e] border-b border-slate-800 sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-20 items-center">
					<div class="flex-shrink-0 flex items-center">
						<a href="/" class="text-2xl font-serif font-extrabold text-white tracking-tight flex items-center gap-2">
							<div class="w-10 h-10 rounded-full border-2 border-primary-500 flex items-center justify-center text-primary-500">
								C
							</div>
							<span>CarScore<span class="text-primary-500">.in</span></span>
						</a>
					</div>
					<nav class="hidden md:flex space-x-8 items-center">
						<a href="/cars" class="text-slate-300 hover:text-white font-bold text-sm transition-colors">Vehicles</a>
						<a href="/compare" class="text-slate-300 hover:text-white font-bold text-sm transition-colors">Compare</a>
						
						<div class="relative group">
							<button class="text-slate-300 hover:text-white font-bold text-sm transition-colors flex items-center gap-1 py-4">
								Calculators
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							</button>
							<div class="absolute left-0 top-[100%] hidden group-hover:block w-56 z-50">
								<div class="bg-[#111a2a] border border-slate-700 rounded shadow-xl py-2 mt-[-8px]">
									<a href="/calculators/total-cost-of-ownership" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">TCO Report</a>
									<a href="/calculators/affordability" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">Affordability</a>
									<a href="/calculators/ev-breakeven" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">EV Breakeven</a>
									<a href="/calculators/emi" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">EMI</a>
									<a href="/calculators/fuel-cost" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">Fuel Cost</a>
									<a href="/calculators/depreciation" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">Resale Value / Depreciation</a>
									<a href="/calculators/ev-charging-cost" class="block px-4 py-2 text-sm font-medium text-slate-300 hover:text-primary-400 hover:bg-slate-800 transition-colors">EV Charging Cost</a>
								</div>
							</div>
						</div>

						<a href="/methodology/total-cost-of-ownership" class="text-slate-300 hover:text-white font-bold text-sm transition-colors">About</a>
					</nav>
					<div class="hidden md:flex items-center">
						<a href="/find-my-match" class="border border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-[#0b131e] font-bold text-xs uppercase tracking-widest px-5 py-2.5 rounded transition-colors">
							Find My Match
						</a>
					</div>
					<div class="md:hidden flex items-center">
						<button class="text-slate-300 hover:text-white">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
						</button>
					</div>
				</div>
			</div>
		</header>
		
		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-[#0b131e] border-t border-slate-800 mt-12">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<div class="col-span-1 md:col-span-2">
						<a href="/" class="text-xl font-serif font-bold text-white flex items-center gap-2">
							<div class="w-8 h-8 rounded-full border-2 border-primary-500 flex items-center justify-center text-primary-500 text-sm">C</div>
							<span>CarScore<span class="text-primary-500">.in</span></span>
						</a>
						<p class="mt-4 text-sm text-slate-400 max-w-sm font-sans">
							An independent automotive utility platform. We provide objective maths to help you make the right car buying decision.
						</p>
					</div>
					<div>
						<h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider font-sans">Reports & Calculators</h3>
						<ul class="mt-4 space-y-2 font-sans">
							<li><a href="/compare" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">N-Car Comparison</a></li>
							<li><a href="/calculators/total-cost-of-ownership" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">TCO Report</a></li>
							<li><a href="/calculators/affordability" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Affordability Calculator</a></li>
							<li><a href="/calculators/ev-breakeven" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">EV Breakeven</a></li>
							<li><a href="/calculators/fuel-cost" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Fuel Efficiency</a></li>
							<li><a href="/calculators/emi" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">EMI Breakdown</a></li>
							<li><a href="/calculators/depreciation" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Resale Value</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider font-sans">Legal</h3>
						<ul class="mt-4 space-y-2 font-sans">
							<li><a href="/about" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">About Us</a></li>
							<li><a href="/editorial-policy" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Editorial Policy</a></li>
							<li><a href="/privacy" class="text-sm text-slate-400 hover:text-primary-400 transition-colors">Privacy Policy</a></li>
						</ul>
					</div>
				</div>
				<div class="mt-12 border-t border-slate-800 pt-8 text-sm text-slate-500 flex justify-between items-center font-sans">
					<p>&copy; {new Date().getFullYear()} CarScore.in. All rights reserved.</p>
					<p>Data updated daily.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
