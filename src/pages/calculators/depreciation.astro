---
import Layout from '../../layouts/Layout.astro';
import { DepreciationCalculator } from '../../components/calculators/DepreciationCalculator';
---

<Layout 
	title="Car Depreciation Calculator India" 
	description="Estimate your car's resale value over time. See how much value your vehicle loses to depreciation each year."
>
	<div class="bg-[#0b131e] border-b border-slate-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="max-w-3xl">
				<span class="inline-flex items-center px-3 py-1 rounded text-[10px] font-bold tracking-widest uppercase text-emerald-400 mb-4 bg-emerald-900/30 border border-emerald-800">
					New Calculator
				</span>
				<h1 class="text-4xl font-serif font-extrabold text-white tracking-tight sm:text-5xl">
					Resale Value Estimator
				</h1>
				<p class="mt-4 text-lg text-slate-400 font-medium">
					Depreciation is often the largest hidden cost of car ownership. Estimate how much your vehicle will be worth in the future based on market trends.
				</p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<DepreciationCalculator client:load />
	</div>
</Layout>
