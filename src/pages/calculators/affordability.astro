---
import Layout from '../../layouts/Layout.astro';
import { AffordabilityCalculator } from '../../components/calculators/AffordabilityCalculator';
---

<Layout 
	title="Car Affordability Calculator India" 
	description="Find out how much car you can afford based on your monthly salary, existing EMIs, and savings."
>
	<div class="bg-[#0b131e] border-b border-slate-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="max-w-3xl">
				<span class="inline-flex items-center px-3 py-1 rounded text-[10px] font-bold tracking-widest uppercase text-emerald-400 mb-4 bg-emerald-900/30 border border-emerald-800">
					New Calculator
				</span>
				<h1 class="text-4xl font-serif font-extrabold text-white tracking-tight sm:text-5xl">
					Car Affordability Calculator
				</h1>
				<p class="mt-4 text-lg text-slate-400 font-medium">
					Work backwards from your monthly income to find your safe car buying budget. We use the 20/4/10 and DTI rules to keep you out of financial stress.
				</p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<AffordabilityCalculator client:load />
		
		<div class="mt-16 border-t border-slate-800 pt-12">
			<h3 class="text-2xl font-serif font-bold text-white mb-6">Next Steps</h3>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<a href="/find-my-match" class="group bg-[#111a2a] p-6 rounded-lg border border-slate-700 hover:border-primary-500 transition-colors">
					<p class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mb-2">Explore</p>
					<h4 class="text-lg font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">Find My Match</h4>
					<p class="text-sm text-slate-400">Now that you know your budget, find cars that perfectly fit your target.</p>
				</a>
				<a href="/calculators/emi" class="group bg-[#111a2a] p-6 rounded-lg border border-slate-700 hover:border-primary-500 transition-colors">
					<p class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mb-2">Deep Dive</p>
					<h4 class="text-lg font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">Calculate Exact EMI</h4>
					<p class="text-sm text-slate-400">Ready to buy? Break down the exact principal and interest for your loan.</p>
				</a>
			</div>
		</div>
	</div>
</Layout>
