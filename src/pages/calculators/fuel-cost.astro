---
import Layout from '../../layouts/Layout.astro';
import { FuelCalculator } from '../../components/calculators/FuelCalculator';
---

<Layout 
	title="Car Fuel Cost Calculator India" 
	description="Calculate the true monthly and annual fuel cost for your Petrol, Diesel, or CNG car."
>
	<div class="bg-white border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="max-w-3xl">
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
					Fuel Cost Calculator
				</h1>
				<p class="mt-4 text-lg text-slate-500 font-medium">
					Calculate exactly how much you'll spend on fuel every month and year. Adjust the mileage to match real-world conditions rather than just laboratory claims.
				</p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<FuelCalculator client:load />

		<div class="mt-16 border-t border-slate-800 pt-12">
			<h3 class="text-2xl font-serif font-bold text-white mb-6">Next Steps</h3>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<a href="/calculators/ev-breakeven" class="group bg-[#111a2a] p-6 rounded-lg border border-slate-700 hover:border-primary-500 transition-colors">
					<p class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mb-2">Switch to EV?</p>
					<h4 class="text-lg font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">EV Breakeven Calculator</h4>
					<p class="text-sm text-slate-400">Tired of high petrol bills? See exactly how many years it takes for an EV to pay for its premium.</p>
				</a>
				<a href="/calculators/depreciation" class="group bg-[#111a2a] p-6 rounded-lg border border-slate-700 hover:border-primary-500 transition-colors">
					<p class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mb-2">Hidden Costs</p>
					<h4 class="text-lg font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">Resale Value Estimator</h4>
					<p class="text-sm text-slate-400">Fuel isn't your only running cost. See how much value your car loses to depreciation every year.</p>
				</a>
			</div>
		</div>
	</div>
</Layout>
