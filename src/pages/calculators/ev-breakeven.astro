---
import Layout from '../../layouts/Layout.astro';
import { BreakevenCalculator } from '../../components/calculators/BreakevenCalculator';
---

<Layout 
	title="EV vs Petrol Breakeven Calculator India" 
	description="Calculate exactly how many years and kilometres it will take to recover the premium price of an Electric Vehicle through fuel savings."
>
	<div class="bg-[#0b131e] border-b border-slate-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="max-w-3xl">
				<span class="inline-flex items-center px-3 py-1 rounded text-[10px] font-bold tracking-widest uppercase text-emerald-400 mb-4 bg-emerald-900/30 border border-emerald-800">
					New Calculator
				</span>
				<h1 class="text-4xl font-serif font-extrabold text-white tracking-tight sm:text-5xl">
					EV vs Petrol Breakeven
				</h1>
				<p class="mt-4 text-lg text-slate-400 font-medium">
					EVs cost more upfront but are cheaper to run. Calculate exactly how many kilometres you need to drive to recover the extra money you paid for the battery.
				</p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<BreakevenCalculator client:load />
	</div>
</Layout>
