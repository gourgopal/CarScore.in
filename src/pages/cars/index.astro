---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const dataPath = path.join(process.cwd(), 'public', 'data', 'variants.json');
const rawData = fs.readFileSync(dataPath, 'utf-8');
const variants = JSON.parse(rawData);

// Group by brand
const brands = [...new Set(variants.map((v: any) => v.brand))].sort();

const getPowertrainColor = (powertrain: string) => {
  switch (powertrain) {
    case 'ELECTRIC': return 'text-emerald-400 bg-emerald-900/30 border-emerald-800';
    case 'PETROL': return 'text-blue-400 bg-blue-900/30 border-blue-800';
    case 'DIESEL': return 'text-slate-400 bg-slate-800 border-slate-700';
    case 'CNG': return 'text-green-400 bg-green-900/30 border-green-800';
    case 'STRONG_HYBRID': return 'text-purple-400 bg-purple-900/30 border-purple-800';
    default: return 'text-slate-400 bg-slate-800 border-slate-700';
  }
};
---

<Layout 
	title="All Cars - Specifications & Cost Analysis" 
	description="Browse our complete database of Indian cars to analyze their specifications, features, and true Total Cost of Ownership."
>
	<div class="bg-[#0b131e] border-b border-slate-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="max-w-3xl">
				<h1 class="text-4xl font-serif font-extrabold text-white tracking-tight sm:text-5xl">
					Vehicle Database
				</h1>
				<p class="mt-4 text-lg text-slate-400 font-medium">
					Select a vehicle to view detailed specifications and dive into its financial breakdown.
				</p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="space-y-16">
      {brands.map((brand: any) => (
        <div>
          <h2 class="text-3xl font-serif font-bold text-white mb-6 border-b border-slate-800 pb-4">{brand}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {variants.filter((v: any) => v.brand === brand).map((variant: any) => (
              <a href={`/cars/${variant.id}`} class="group bg-[#111a2a] rounded-lg border border-slate-700 hover:border-primary-500 p-6 transition-colors flex flex-col justify-between relative overflow-hidden">
                {variant.scores && (
                  <div class="absolute top-0 right-0 bg-slate-800 text-white font-bold text-lg px-4 py-3 rounded-bl-lg border-b border-l border-slate-700 group-hover:bg-primary-500 group-hover:text-[#0b131e] group-hover:border-primary-500 transition-colors">
                    {variant.scores.overall}
                    <span class="text-xs font-normal opacity-80 ml-1">{variant.scores.grade}</span>
                  </div>
                )}
                <div class={variant.scores ? "pr-16" : ""}>
                  <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors">{variant.name}</h3>
                  <div class="flex flex-wrap gap-2">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold tracking-widest uppercase border ${getPowertrainColor(variant.powertrain)}`}>
                      {variant.powertrain.replace('_', ' ')}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold tracking-widest uppercase border text-slate-400 bg-slate-800 border-slate-700">
                      {variant.transmission.replace('_', ' ')}
                    </span>
                  </div>
                </div>
                <div class="mt-8 flex justify-between items-center text-xs font-bold uppercase tracking-widest text-slate-500">
                  <span>View Specs</span>
                  <span class="group-hover:text-primary-400 transition-colors">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

	</div>
</Layout>
