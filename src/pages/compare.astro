---
import Layout from '../layouts/Layout.astro';
import { TcoCompare } from '../components/calculators/TcoCompare';
---

<Layout 
	title="Compare Car Ownership Costs (TCO)" 
	description="Compare the real total cost of ownership between ICE, CNG, and Electric cars. Understand fuel costs, depreciation, and maintenance."
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
			<div class="max-w-3xl">
				<h1 class="text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl">
					Compare Total Cost of Ownership
				</h1>
				<p class="mt-4 text-lg text-gray-500">
					Compare the real-world financial impact of different vehicles. We calculate exact running costs based on your usage, plus depreciation, insurance, and service.
				</p>
			</div>
			<div class="flex-shrink-0 flex gap-2">
				<button class="text-sm font-medium text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-2 rounded-md">Edit Assumptions</button>
			</div>
		</div>

		<!-- Interactive Client Island -->
		<TcoCompare client:load />

		<div class="mt-16 bg-gray-50 rounded-lg p-8 border border-gray-200">
			<h2 class="text-xl font-bold text-gray-900 mb-4">How we calculate Economic TCO</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm text-gray-600">
				<div>
					<p class="mb-4">
						Economic Total Cost of Ownership represents the actual net wealth you lose by owning and operating the vehicle over the selected period.
					</p>
					<p>
						<strong>Included:</strong> Acquisition price (on-road), interest paid on loans, all energy (fuel/charging) consumed, scheduled servicing, insurance renewals, and estimated resale depreciation.
					</p>
				</div>
				<div>
					<p class="mb-4">
						We do <strong>not</strong> double-count loan principal. The principal is simply paying off the acquisition cost of the asset. We only penalize the TCO for the <em>interest and fees</em> paid to the bank.
					</p>
					<p>
						<a href="/methodology/total-cost-of-ownership" class="text-blue-600 hover:underline">Read the full mathematical methodology &rarr;</a>
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>
